{
  "name": "enterprise-agent-platform",
  "version": "0.1.0",
  "description": "Enterprise-grade agent platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @enterprise-agent/api",
    "dev:web": "npm run dev -w @enterprise-agent/web",
    "build": "npm run build -w @enterprise-agent/api",
    "build:web": "npm run build -w @enterprise-agent/web",
    "start:api": "npm run start -w @enterprise-agent/api",
    "start:web": "npm run start -w @enterprise-agent/web",
    "check": "npm run check -w @enterprise-agent/api",
    "check:web": "npm run check -w @enterprise-agent/web",
    "test": "npm run test -w @enterprise-agent/api",
    "test:unit": "npm run test:unit -w @enterprise-agent/api",
    "test:integration": "npm run test:integration -w @enterprise-agent/api",
    "test:e2e": "npm run test:e2e -w @enterprise-agent/api",
    "test:e2e:web": "npm run test:e2e -w @enterprise-agent/web",
    "docs:openapi": "npm run docs:openapi -w @enterprise-agent/api",
    "ci": "npm run check && npm test && npm run docs:openapi && npm run build",
    "docker:build": "docker build -f apps/api/Dockerfile -t enterprise-agent-api:local .",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t enterprise-agent-web:local .",
    "compose:prod:config": "docker compose -f infra/docker-compose.prod.yml config",
    "compose:prod:up": "docker compose -f infra/docker-compose.prod.yml up -d --build",
    "compose:prod:down": "docker compose -f infra/docker-compose.prod.yml down",
    "db:generate": "npm run db:generate -w @enterprise-agent/api",
    "db:migrate": "npm run db:migrate -w @enterprise-agent/api",
    "db:push": "npm run db:push -w @enterprise-agent/api",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "license": "MIT"
}
