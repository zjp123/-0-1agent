# Public Web profile label.
# Allowed values: local, development, staging, production, test
NEXT_PUBLIC_WEB_ENV=local

# Browser-visible API URL. Must be an absolute HTTP(S) URL ending with /api.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api

# Do not add secrets here.
# Any NEXT_PUBLIC_* variable is bundled into the browser and visible to users.
# API keys, service tokens, JWT secrets, database passwords, and LLM keys belong
# in the API/runtime environment or the governed login flow, not in Web public env.
