# Runtime
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Web Console public runtime
# Allowed values: local, development, staging, production, test
NEXT_PUBLIC_WEB_ENV=local
# Browser-visible API URL. Must end with /api. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api
WEB_PORT=3001

# Development API key guard and Web Console API-key login credential.
# Generate a local value yourself, for example: openssl rand -hex 32
# If omitted in development, requests can run as dev-user/default tenant.
# Required in production.
API_KEY=zjl_ldh_zjp
JWT_SECRET=development-only-jwt-secret-change-me
JWT_ISSUER=enterprise-agent-api
JWT_AUDIENCE=enterprise-agent-web
SERVICE_TOKEN=local-admin-service-token
SERVICE_TOKEN_ROLES=admin
SERVICE_TOKEN_TENANT_ID=default

# LLM provider
LLM_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-6e2e272e587f47d18d93c1028216c99c
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Database / infrastructure
DATABASE_URL=postgresql://agent:agent_password@localhost:15432/agent_db
DATABASE_POOL_MAX=10
POSTGRES_DB=agent_db
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_password
POSTGRES_PORT=15432
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# MCP external tools
# No MCP server is started when MCP_SERVERS is empty.
# When MCP_SERVERS is configured, MCP is enabled automatically.
# Set MCP_ENABLED=false only when you need to force-disable configured servers.
# MCP_ENABLED=false
MCP_CONNECT_TIMEOUT_MS=10000
MCP_TOOL_TIMEOUT_MS=15000
# Example local MCP server:
# MCP_SERVERS=[{"name":"local_mcp","command":"node","args":["tools/mcp/echo-server.mjs"],"toolNamePrefix":"local_mcp","riskLevel":"low","requiredPermissions":["tools:execute"]}]

# Workflow scheduler loop
# The background loop automatically scans for due workflow schedules, claims them,
# executes the workflow steps via Agent Runtime, and completes the schedule run.
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_SCHEDULER_INTERVAL_MS=30000
WORKFLOW_SCHEDULER_LEASE_MS=120000
WORKFLOW_SCHEDULER_MAX_STEPS=10
WORKFLOW_SCHEDULER_STUCK_TIMEOUT_MS=300000
